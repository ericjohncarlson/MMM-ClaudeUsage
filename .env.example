# Copy to .env in this module folder (or pass via docker env_file).
# A refresh token alone is enough — the module mints access tokens from it
# and keeps the rotated tokens in .token-cache.json next to this file.
CLAUDE_REFRESH_TOKEN=sk-ant-ort01-...

# Optional: seed an access token too (skips the first refresh)
# CLAUDE_ACCESS_TOKEN=sk-ant-oat01-...
# CLAUDE_TOKEN_EXPIRES_AT=1792529012422   # ms epoch, from expiresAt
